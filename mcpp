#!/usr/bin/env bash
#
# mcpp -- the workflow driver for this course.
#
#   ./mcpp next                 build and run the first exercise that is not
#                               yet passing; this is the main loop
#   ./mcpp test [filter]        run the exercises matching a filter
#   ./mcpp verify               run every exercise (what CI does)
#   ./mcpp solution <filter>    diff your work against the reference solution
#   ./mcpp list [filter]        list the exercises and where you are
#   ./mcpp build [filter]       build without running
#   ./mcpp profile <filter>     run one exercise under Nsight Systems
#                               (--ncu: under Nsight Compute)   [GPU machine]
#   ./mcpp format [--check]     run clang-format over the tree
#   ./mcpp tidy [filter]        run clang-tidy over the tree
#   ./mcpp clean                remove the build directories
#
# A "filter" is any substring of an exercise id, so `03`, `03_07`, `unique_ptr`
# and `07_unique_ptr` all select 03.07. It is passed to ctest as a regex.
#
# Chapters 14-17 (CUDA) need nvcc and an NVIDIA GPU. On a machine without
# them, `next` skips those exercises and `test` explains; everything else works
# as before. On a machine with them, the `cuda` preset is picked automatically.
# Set MCPP_PRESET to override the choice (for example MCPP_PRESET=debug to
# build only the C++ chapters on the GPU machine).

set -euo pipefail

readonly ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# --- which preset ------------------------------------------------------------

detect_preset() {
  if [[ -n "${MCPP_PRESET:-}" ]]; then
    printf '%s\n' "${MCPP_PRESET}"
  elif [[ "$(uname -s)" == "Linux" ]] && command -v nvcc >/dev/null 2>&1; then
    printf 'cuda\n'
  else
    printf 'debug\n'
  fi
}

readonly PRESET="$(detect_preset)"
readonly BUILD_DIR="${ROOT}/cmake-build-${PRESET}"
if [[ "${PRESET}" == cuda* ]]; then
  readonly SOLUTION_PRESET="cuda-solutions"
else
  readonly SOLUTION_PRESET="solutions"
fi
readonly SOLUTION_BUILD_DIR="${ROOT}/cmake-build-${SOLUTION_PRESET}"
readonly PROGRESS_FILE="${ROOT}/.mcpp-progress"

cuda_available() {
  [[ "${PRESET}" == cuda* ]]
}

if [[ -t 1 ]]; then
  readonly BOLD=$'\033[1m' DIM=$'\033[2m' RED=$'\033[31m' GREEN=$'\033[32m'
  readonly YELLOW=$'\033[33m' BLUE=$'\033[34m' RESET=$'\033[0m'
else
  readonly BOLD='' DIM='' RED='' GREEN='' YELLOW='' BLUE='' RESET=''
fi

die() {
  printf '%smcpp: %s%s\n' "${RED}" "$*" "${RESET}" >&2
  exit 1
}

# A few exercises start out as programs that never terminate -- a worker thread
# with no cancellation check, a wait nobody notifies. Running them with a
# deadline turns "the terminal is hung" into a message that says so.
readonly DEADLINE_SECONDS=30

run_exercise() {
  local binary="$1"
  perl -e 'alarm shift; exec @ARGV or exit 127' "${DEADLINE_SECONDS}" "${binary}"
  local status=$?
  if [[ ${status} -eq 142 || ${status} -eq 14 ]]; then
    printf '\n%smcpp: it did not finish within %ss -- this exercise starts as a\n' \
      "${YELLOW}" "${DEADLINE_SECONDS}"
    printf '      program that never terminates. Read the header comment.%s\n' "${RESET}"
    return 1
  fi
  return ${status}
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "'$1' is not on your PATH. $2"
}

# --- exercise inventory ------------------------------------------------------

# Prints "<id>\t<directory>\t<kind>" for every exercise, in course order.
#   id        = 03_07_unique_ptr   (chapter number, exercise number, name)
#   directory = exercises/03_ownership/07_unique_ptr
#   kind      = cpp | cuda         (exercise.cpp or exercise.cu)
all_exercises() {
  local dir chapter name chapter_number kind
  while IFS= read -r dir; do
    chapter="$(basename "$(dirname "${dir}")")"
    name="$(basename "${dir}")"
    chapter_number="${chapter%%_*}"
    kind=cpp
    [[ -f "${dir}/exercise.cu" ]] && kind=cuda
    printf '%s\t%s\t%s\n' "${chapter_number}_${name}" "${dir}" "${kind}"
  done < <(find "${ROOT}/exercises" -mindepth 2 -maxdepth 2 -type d | sort)
}

# The source file of an exercise directory: exercise.cpp or exercise.cu.
source_of() {
  local dir="$1"
  if [[ -f "${dir}/exercise.cu" ]]; then
    printf '%s/exercise.cu\n' "${dir}"
  else
    printf '%s/exercise.cpp\n' "${dir}"
  fi
}

resolve_one() {
  local filter="$1" matches
  matches="$(all_exercises | grep -- "${filter}" || true)"
  [[ -n "${matches}" ]] || die "no exercise matches '${filter}'. Try ./mcpp list"
  if [[ "$(wc -l <<<"${matches}")" -gt 1 ]]; then
    printf '%smcpp: '\''%s'\'' matches several exercises:%s\n' \
      "${YELLOW}" "${filter}" "${RESET}" >&2
    cut -f1 <<<"${matches}" | sed 's/^/  /' >&2
    exit 1
  fi
  printf '%s\n' "${matches}"
}

require_cuda_for() {
  local id="$1" kind="$2"
  if [[ "${kind}" == cuda ]] && ! cuda_available; then
    die "${id} is a CUDA exercise and this machine has no nvcc. Build it on the GPU machine (see README: 'The CUDA track')."
  fi
}

# --- build -------------------------------------------------------------------

configure() {
  local dir="$1" preset="$2"
  if [[ ! -f "${dir}/CMakeCache.txt" ]]; then
    printf '%s==> configuring (%s)%s\n' "${BOLD}" "${preset}" "${RESET}"
    cmake --preset "${preset}" >/dev/null || die "cmake configure failed"
  fi
}

# Builds one target, letting the compiler's diagnostics through untouched.
build_target() {
  local target="$1"
  configure "${BUILD_DIR}" "${PRESET}"
  cmake --build "${BUILD_DIR}" --target "${target}"
}

# --- commands ----------------------------------------------------------------

cmd_list() {
  local filter="${1:-}" id dir kind current
  current="$(cat "${PROGRESS_FILE}" 2>/dev/null || true)"
  local last_chapter=''
  while IFS=$'\t' read -r id dir kind; do
    [[ -z "${filter}" || "${id}" == *"${filter}"* ]] || continue
    local chapter
    chapter="$(basename "$(dirname "${dir}")")"
    if [[ "${chapter}" != "${last_chapter}" ]]; then
      printf '\n%s%s%s\n' "${BOLD}" "${chapter//_/ }" "${RESET}"
      last_chapter="${chapter}"
    fi
    local marker='  ' tag=''
    [[ "${id}" == "${current}" ]] && marker="${BLUE}->${RESET}"
    if [[ "${kind}" == cuda ]] && ! cuda_available; then
      tag="  ${DIM}(CUDA: needs the GPU machine)${RESET}"
    fi
    printf '  %s %s%s\n' "${marker}" "${id}" "${tag}"
  done < <(all_exercises)
  printf '\n'
}

cmd_build() {
  local filter="${1:-}"
  configure "${BUILD_DIR}" "${PRESET}"
  if [[ -z "${filter}" ]]; then
    cmake --build "${BUILD_DIR}" --target exercises -- -k 0
  else
    local id dir kind
    IFS=$'\t' read -r id dir kind < <(resolve_one "${filter}")
    require_cuda_for "${id}" "${kind}"
    build_target "ex_${id}"
  fi
}

cmd_test() {
  local filter="${1:-}"
  if [[ -z "${filter}" ]]; then
    cmd_verify
    return
  fi
  local id dir kind
  IFS=$'\t' read -r id dir kind < <(resolve_one "${filter}")
  require_cuda_for "${id}" "${kind}"
  printf '%s==> %s%s\n%s   %s%s\n' \
    "${BOLD}" "${id}" "${RESET}" "${DIM}" "$(source_of "${dir}")" "${RESET}" |
    sed "s|${ROOT}/||"
  build_target "ex_${id}"
  run_exercise "${BUILD_DIR}/bin/exercises/$(basename "$(dirname "${dir}")")/ex_${id}"
}

cmd_verify() {
  configure "${BUILD_DIR}" "${PRESET}"
  # Some exercises deliberately do not compile until you have done the work
  # (making a function `constexpr`, say). `-k 0` tells the generator to keep
  # going after a failure so that one unfinished exercise does not hide the
  # state of the other ninety-nine.
  cmake --build "${BUILD_DIR}" --target exercises -- -k 0 || true
  ctest --test-dir "${BUILD_DIR}" --output-on-failure
}

# The main loop: walk the exercises in order and stop at the first one that
# does not build or does not pass. That is the one you are working on.
cmd_next() {
  local id dir kind chapter binary skipped=0
  while IFS=$'\t' read -r id dir kind; do
    chapter="$(basename "$(dirname "${dir}")")"
    binary="${BUILD_DIR}/bin/exercises/${chapter}/ex_${id}"

    if [[ "${kind}" == cuda ]] && ! cuda_available; then
      printf '%sskip%s %s %s(CUDA)%s\n' "${DIM}" "${RESET}" "${id}" "${DIM}" "${RESET}"
      skipped=$((skipped + 1))
      continue
    fi

    if ! build_target "ex_${id}" >/dev/null 2>&1; then
      printf '%s==> %s does not compile%s\n\n' "${RED}" "${id}" "${RESET}"
      printf '%s\n' "${id}" >"${PROGRESS_FILE}"
      build_target "ex_${id}" || true
      printf '\n%s    %s%s\n' \
        "${DIM}" "$(source_of "${dir}" | sed "s|${ROOT}/||")" "${RESET}"
      return 1
    fi

    if ! (run_exercise "${binary}" >/dev/null 2>&1); then
      printf '%s==> %s%s\n%s    %s%s\n\n' "${BOLD}" "${id}" "${RESET}" "${DIM}" \
        "$(source_of "${dir}" | sed "s|${ROOT}/||")" "${RESET}"
      printf '%s\n' "${id}" >"${PROGRESS_FILE}"
      run_exercise "${binary}" || true
      return 1
    fi

    printf '%s  ok%s %s\n' "${GREEN}" "${RESET}" "${id}"
  done < <(all_exercises)

  if [[ ${skipped} -gt 0 ]]; then
    printf '\n%sEvery C++ exercise passes. %d CUDA exercises were skipped because\n' \
      "${GREEN}${BOLD}" "${skipped}"
    printf 'this machine has no nvcc -- run ./mcpp next on the GPU machine.%s\n' "${RESET}"
  else
    printf '\n%sEvery exercise passes. That is the whole course.%s\n' \
      "${GREEN}${BOLD}" "${RESET}"
  fi
  rm -f "${PROGRESS_FILE}"
}

cmd_solution() {
  local filter="${1:-$(cat "${PROGRESS_FILE}" 2>/dev/null || true)}"
  [[ -n "${filter}" ]] || die "usage: ./mcpp solution <filter>"
  local id dir kind solution
  IFS=$'\t' read -r id dir kind < <(resolve_one "${filter}")
  solution="$(source_of "${ROOT}/solutions/$(basename "$(dirname "${dir}")")/$(basename "${dir}")")"
  [[ -f "${solution}" ]] || die "no solution checked in for ${id}"

  printf '%s==> %s: your work vs. the reference solution%s\n\n' \
    "${BOLD}" "${id}" "${RESET}"

  # Strip each file's leading comment block before diffing. The exercise's
  # header is the teaching material and the solution's is one line, so
  # including them would bury the actual difference in forty lines of prose.
  local yours reference
  yours="$(mktemp)"
  reference="$(mktemp)"
  strip_header "$(source_of "${dir}")" >"${yours}"
  strip_header "${solution}" >"${reference}"

  diff --unified=3 --label 'yours' --label 'reference' "${yours}" "${reference}" ||
    true
  rm -f "${yours}" "${reference}"
}

# Prints a file from its first non-comment, non-blank line onward.
strip_header() {
  awk '
    started { print; next }
    /^[[:space:]]*\/\// { next }
    /^[[:space:]]*$/ { next }
    { started = 1; print }
  ' "$1"
}

# Runs one exercise under a profiler and leaves the report next to the build
# directory. Chapter 17 explains how to read it. Nsight Systems answers "where
# did the time go?" across the whole program (launch gaps, copies, syncs);
# Nsight Compute answers "why is THIS kernel slow?" and needs the binary to
# have been built with -lineinfo, which cmake/Cuda.cmake does.
cmd_profile() {
  local filter="${1:-}" tool=nsys
  [[ -n "${filter}" ]] || die "usage: ./mcpp profile <filter> [--ncu]"
  [[ "${2:-}" == "--ncu" ]] && tool=ncu
  cuda_available || die "profiling needs the GPU machine (no nvcc here)"
  local id dir kind
  IFS=$'\t' read -r id dir kind < <(resolve_one "${filter}")
  [[ "${kind}" == cuda ]] || die "${id} is not a CUDA exercise"
  build_target "ex_${id}"
  local binary="${BUILD_DIR}/bin/exercises/$(basename "$(dirname "${dir}")")/ex_${id}"
  local report="${BUILD_DIR}/profile_${id}"
  if [[ "${tool}" == ncu ]]; then
    need ncu "It ships with the CUDA toolkit: /usr/local/cuda/bin/ncu"
    # --set full collects every section, including the source-level view. If
    # this fails with ERR_NVGPUCTRPERM, see the README: the driver has to be
    # told to let non-root users read the performance counters.
    ncu --set full --import-source yes -f -o "${report}" "${binary}"
    printf '\n%sreport: %s.ncu-rep  (open it with ncu-ui)%s\n' "${GREEN}" "${report}" "${RESET}"
  else
    need nsys "It ships with the CUDA toolkit: /usr/local/cuda/bin/nsys"
    nsys profile --stats=true -f true -o "${report}" "${binary}"
    printf '\n%sreport: %s.nsys-rep  (open it with nsys-ui)%s\n' "${GREEN}" "${report}" "${RESET}"
  fi
}

cmd_format() {
  need clang-format "Install it with: brew install llvm"
  # A while-read loop rather than `mapfile`: macOS still ships bash 3.2.
  local -a files=()
  local file
  while IFS= read -r file; do
    files+=("${file}")
  done < <(find "${ROOT}/exercises" "${ROOT}/solutions" \
    \( -name '*.cpp' -o -name '*.hpp' -o -name '*.cu' -o -name '*.cuh' \) | sort)

  if [[ "${1:-}" == "--check" ]]; then
    clang-format --dry-run --Werror "${files[@]}"
    printf '%sformatting is clean%s\n' "${GREEN}" "${RESET}"
  else
    clang-format -i "${files[@]}"
    printf '%sformatted %d files%s\n' "${GREEN}" "${#files[@]}" "${RESET}"
  fi
}

cmd_tidy() {
  need clang-tidy "Install it with: brew install llvm"
  configure "${BUILD_DIR}" "${PRESET}"
  local filter="${1:-}"
  local -a files=()
  if [[ -n "${filter}" ]]; then
    local id dir kind
    IFS=$'\t' read -r id dir kind < <(resolve_one "${filter}")
    [[ "${kind}" == cpp ]] || die "clang-tidy is not wired up for CUDA files; ${id} is one"
    files=("${dir}/exercise.cpp")
  else
    # Only the C++ chapters: clang-tidy cannot follow nvcc's flags.
    local file
    while IFS= read -r file; do
      files+=("${file}")
    done < <(find "${ROOT}/exercises" -name '*.cpp' | sort)
  fi
  clang-tidy -p "${BUILD_DIR}" "${files[@]}"
}

cmd_clean() {
  rm -rf "${ROOT}"/cmake-build-*
  rm -f "${PROGRESS_FILE}"
  printf '%sremoved build directories%s\n' "${GREEN}" "${RESET}"
}

cmd_solutions_check() {
  # Used by CI to prove every reference solution actually passes.
  configure "${SOLUTION_BUILD_DIR}" "${SOLUTION_PRESET}"
  cmake --build "${SOLUTION_BUILD_DIR}" --target solutions
  ctest --test-dir "${SOLUTION_BUILD_DIR}" --output-on-failure -R '^solution/'
}

usage() {
  sed -n '3,28p' "${BASH_SOURCE[0]}" | sed 's|^# \{0,1\}||'
}

main() {
  need cmake "Install it with: brew install cmake"
  local command="${1:-next}"
  shift || true
  case "${command}" in
    next) cmd_next "$@" ;;
    test | t) cmd_test "$@" ;;
    verify) cmd_verify "$@" ;;
    build) cmd_build "$@" ;;
    list | ls) cmd_list "$@" ;;
    solution | sol) cmd_solution "$@" ;;
    profile | prof) cmd_profile "$@" ;;
    format | fmt) cmd_format "$@" ;;
    tidy) cmd_tidy "$@" ;;
    clean) cmd_clean "$@" ;;
    solutions-check) cmd_solutions_check "$@" ;;
    help | -h | --help) usage ;;
    *) die "unknown command '${command}'. Try ./mcpp help" ;;
  esac
}

main "$@"
